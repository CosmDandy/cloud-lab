#cloud-config
# Минимальный bootstrap: довести машину до состояния, в котором до неё
# дотянется Ansible. Всё остальное — пакеты, пользователь деплоя, hardening
# sshd, docker с ротацией логов, раннер, sysctl с bbr — делают роли base,
# docker, github-runner и vpn_tuning.
#
# Так сделано потому, что cloud-init выполняется ровно один раз. Описанное
# здесь нельзя ни поправить, ни перезапустить, не пересоздав сервер;
# описанное ролями применяется к живой машине повторно и одинаково
# работает у любого провайдера, включая тех, у кого cloud-init нет вовсе.

users:
  - name: root
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

package_update: true

packages:
  # Интерпретатор для Ansible. На ubuntu-24.04 уже есть; указан явно,
  # чтобы смена образа не ломала первый же прогон плейбука.
  - python3
