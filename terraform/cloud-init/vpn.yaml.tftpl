#cloud-config
# Минимальный bootstrap: довести машину до состояния, в котором до неё
# дотянется Ansible. Пакеты, пользователь деплоя, hardening sshd, docker,
# раннер и сетевой тюнинг делают роли base, docker, github-runner и
# vpn_tuning — см. комментарий в server.yaml.tftpl.

users:
  - name: root
    ssh_authorized_keys:
%{ for key in ssh_public_keys ~}
      - ${key}
%{ endfor ~}

package_update: true

packages:
  - python3
