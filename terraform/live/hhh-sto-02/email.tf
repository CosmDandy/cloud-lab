# ──────────────────────────────────────────────
# Почта домена
#
# Отправки с этой машины нет и не было: MX ведут на Cloudflare Email
# Routing, который умеет только принимать и пересылать. Письма от имени
# домена шлёт Resend поверх Amazon SES, его SPF и DKIM заведены вне
# терраформа и здесь не описываются.
# ──────────────────────────────────────────────

# Без DMARC любой может отправить письмо от имени домена, и оно имеет шансы
# дойти: SPF и DKIM сами по себе лишь помечают результат проверки, но не
# говорят получателю, что делать с письмом, которое её не прошло.
#
# p=reject, а не p=none, потому что выравнивание уже сходится: Resend
# подписывает как d=cosmdandy.dev, то есть DKIM выравнивается строго, а
# envelope-from в send.cosmdandy.dev выравнивает SPF по организационному
# домену. Ломается ровно один сценарий — «отправить как я@cosmdandy.dev»
# через чужой SMTP вроде Gmail; такого здесь нет.
#
# Поддомены отдельной политикой не описаны намеренно: без sp они наследуют
# p, и send.cosmdandy.dev попадает под тот же reject.
#
# Отчёты не запрашиваются: rua требует живого ящика, иначе принимающая
# сторона копит отбойники на несуществующий адрес. Чтобы включить — завести
# форвард dmarc@ в Email Routing и дописать rua=mailto:dmarc@cosmdandy.dev.
resource "cloudflare_dns_record" "dmarc" {
  zone_id = var.cloudflare_zone_id
  name    = "_dmarc"
  type    = "TXT"
  content = "v=DMARC1; p=reject"
  ttl     = 300
  comment = "managed-by:terraform DMARC"
}
