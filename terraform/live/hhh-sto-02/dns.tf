# ──────────────────────────────────────────────
# Боевой control-plane: hhh-sto-02, HostHatch Стокгольм
#
# Сюда переезжает то, что репетировалось на htz-hel-test. Причина переезда
# не в самой машине, а в доступности: Hetzner с домашнего канала не берётся
# (0 байт за 11 с), HostHatch берётся (10.7 МБ/с, замер 30.07.2026), а
# mesh/oidc/grafana/status/traefik — непроксируемые записи, то есть ходят
# прямо на адрес сервера.
#
# ВНИМАНИЕ к порядку применения: те же пять CNAME сейчас принадлежат
# воркспейсу htz-hel-test. Cloudflare не даёт двум записям одно имя, поэтому
# сначала применяется удаление алиасов там, потом создание здесь. Разрыв —
# около минуты плюс TTL 300 у резолверов, которые успеют закешировать
# отрицательный ответ. Делать наоборот нельзя: apply здесь упадёт на
# конфликте имён.
# ──────────────────────────────────────────────

module "dns" {
  source = "../../modules/dns-record"

  zone_id      = var.cloudflare_zone_id
  name         = var.server_name
  ipv4_address = var.ipv4_address

  enable_ipv6  = var.enable_ipv6
  ipv6_address = var.ipv6_address

  # Две группы с разным проксированием, поэтому merge, а не один цикл.
  aliases = merge(
    # Инфраструктурные имена НЕ проксируются, и это не недосмотр: headscale
    # раздаёт клиентам адрес узла под встроенный DERP, а за Cloudflare виден
    # был бы только адрес Cloudflare.
    {
      for name in ["mesh", "oidc", "grafana", "status", "traefik"] :
      name => {
        target  = "${var.server_name}.${var.domain}"
        proxied = false
      }
    },
    # Панель и подписки — наоборот, проксируются: поглощение DDoS и
    # доступность оттуда, откуда сам HostHatch мог бы не открыться. Ходят
    # сюда только браузером и клиентом подписки; VPN-трафик идёт мимо,
    # прямо на ноды.
    #
    # Сокрытия адреса это НЕ даёт, вопреки очевидному предположению.
    # Cloudflare предупреждает, что цель CNAME (A-запись hhh-sto-02) не
    # проксируется, — но дело даже не в ней: пять имён выше отдают
    # 167.104.104.209 первым же запросом, а mesh обязан быть прямым
    # принципиально (STUN на UDP 3478 не проксируется вовсе, плюс длинные
    # соединения с апгрейдом в Noise). Адрес публичен по устройству, и
    # закрыть его можно было бы только проксированием всего, кроме mesh, —
    # решение отложено осознанно.
    #
    # Переехали из корневого модуля 30.07.2026. Порядок был неустраним:
    # сначала apply там удаляет обе записи, только потом apply здесь их
    # создаёт — имя в зоне уникально, и обратный порядок падает на конфликте.
    {
      for name in ["vpn", "sub"] :
      name => {
        target  = "${var.server_name}.${var.domain}"
        proxied = true
      }
    },
  )

  comment = "боевой control-plane"
}
