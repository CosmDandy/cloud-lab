# ──────────────────────────────────────────────
# Боевой control-plane: hhh-sto-02, HostHatch Стокгольм
#
# Переезд со стенда htz-hel-test завершён 30.07.2026, тот воркспейс удалён.
# Причина переезда была не в машине, а в доступности: Hetzner с домашнего
# канала не берётся (0 байт за 11 с), HostHatch берётся (10.7 МБ/с).
#
# Записи ходят прямо на адрес сервера — ни одна из них не проксируется.
# ──────────────────────────────────────────────

module "dns" {
  source = "../../modules/dns-record"

  zone_id      = var.cloudflare_zone_id
  name         = var.server_name
  ipv4_address = var.ipv4_address

  enable_ipv6  = var.enable_ipv6
  ipv6_address = var.ipv6_address

  # Две группы с разным проксированием, поэтому merge, а не один цикл.
  aliases = merge(
    # Инфраструктурные имена НЕ проксируются, и это не недосмотр: headscale
    # раздаёт клиентам адрес узла под встроенный DERP, а за Cloudflare виден
    # был бы только адрес Cloudflare.
    #
    # status.vpn — публичная страница состояния, и для неё прямая запись
    # обязательна по другой причине: её открывают из России, а адреса
    # Cloudflare оттуда недоступны. Проксировать её значит спрятать ответ
    # ровно от тех, кому он адресован.
    #
    # vm — приёмник метрик с нод. Наружу открыт единственный путь
    # /api/v1/write под basic auth; имя нужно ровно затем, чтобы traefik мог
    # получить на него сертификат: пароль уходит с каждой отправкой, и по
    # обычному http он ходил бы почти открытым текстом.
    {
      for name in ["mesh", "oidc", "grafana", "status", "status.vpn", "traefik", "vm"] :
      name => {
        target  = "${var.server_name}.${var.domain}"
        proxied = false
      }
    },
    # Панель и подписки проксировались до 12.08.2026 — ради поглощения DDoS.
    # Проксирование снято: адреса Cloudflare недоступны из России, а через
    # эти два имени пользователь получает конфиг и продлевает подписку.
    # Витрина, которую не открыть, хуже отсутствующей.
    #
    # Сокрытия адреса проксирование здесь и не давало: остальные имена
    # отдают 167.104.104.209 первым же запросом, а mesh обязан быть прямым
    # принципиально — STUN на UDP 3478 не проксируется вовсе.
    #
    # Переехали из корневого модуля 30.07.2026. Порядок был неустраним:
    # сначала apply там удаляет обе записи, только потом apply здесь их
    # создаёт — имя в зоне уникально, и обратный порядок падает на конфликте.
    {
      for name in ["vpn", "sub"] :
      name => {
        target  = "${var.server_name}.${var.domain}"
        proxied = false
      }
    },
    # atuin — синхронизация истории shell. Не проксируется по той же
    # причине, что панель и подписки: CLI ходит с рабочих машин, в том
    # числе из России. История шифруется end-to-end на клиенте, так что
    # проксирование ничего не добавило бы и к приватности.
    {
      atuin = {
        target  = "${var.server_name}.${var.domain}"
        proxied = false
      }
    },
  )

  comment = "боевой control-plane"
}
