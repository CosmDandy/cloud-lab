.DS_Store
.env
!*.env.tpl
secrets/

# Sing-box TLS certs
stacks/vpn-legacy/sing-box/tls/

# Generated sing-box client configs (from .jsonnet)
stacks/vpn-legacy/sing-box/client-*.json.tpl

# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/tfplan
terraform/secrets.auto.tfvars

# Backups (contain sensitive data)
backups/

# Секреты попадают в git только зашифрованными. Файл с именем secrets,
# но без .sops — это забытое шифрование, а не новая схема хранения.
**/secrets*.yml
**/secrets*.yaml
!**/secrets.sops.yaml
!**/secrets.sops.yml
