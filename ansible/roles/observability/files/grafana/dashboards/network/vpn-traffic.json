      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Отдача клиенту",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) unless on (peer) vpn_peer_user)) * 8 and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) unless on (peer) vpn_peer_user)) > 65536)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum by (username, inbound) ((rate(vpn_client_tcp_retrans_bytes_total{instance=~\"$node\"}[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_retrans_bytes_total{instance=~\"$node\"}[10m])) unless on (peer) vpn_peer_user)) / sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) unless on (peer) vpn_peer_user)) and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) unless on (peer) vpn_peer_user)) > 65536)",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (username, inbound) ((vpn_client_tcp_rtt_ms{instance=~\"$node\"}) * on (peer) group_left (username) vpn_peer_user or ((vpn_client_tcp_rtt_ms{instance=~\"$node\"}) unless on (peer) vpn_peer_user)) and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total{instance=~\"$node\"}[10m])) unless on (peer) vpn_peer_user)) > 65536)",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
