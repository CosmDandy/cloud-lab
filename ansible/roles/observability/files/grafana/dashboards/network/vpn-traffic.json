      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum((rate(node_netstat_TcpExt_TCPSynRetrans{instance=~\"$node\"}[10m])) and on (instance) xray_up{instance=~\"$node\"})",
          "legendFormat": "SYN/с",
          "refId": "A",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Сборщиков не работает",
      "description": "Экспорт счётчиков xray и eBPF по Hysteria2 на каждой ноде панели. Нода, которая перестала присылать метрики совсем, тоже считается. 0 — все живы.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "(count(remnawave_node_basic_info{node_name=~\"$node\"}) - (count(xray_up{instance=~\"$node\"} == 1) or vector(0))) + (count(remnawave_node_basic_info{node_name=~\"$node\"}) - (count(hy2_collector_up{instance=~\"$node\"} == 1) or vector(0)))",
          "legendFormat": "сборщиков",
          "refId": "A",
          "range": false,
          "instant": true
