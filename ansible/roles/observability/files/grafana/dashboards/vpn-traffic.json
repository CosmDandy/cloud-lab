    {
      "id": 6,
      "type": "table",
      "title": "Клиенты за последние 10 минут",
      "description": "Только TCP-транспорты: у Hysteria2 нет соединений, его клиенты — в разделе ниже. Пустое имя — справочник ещё не видел этот адрес в логах. Потери до 5 % у российских провайдеров — фон; RTT к минимуму выше 3 — очередь на пути.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Отдача клиенту"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Потери"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RTT"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RTT к минимуму"
            },
            "properties": [
              {
                "id": "unit",
                "value": "x"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Отдача клиенту",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total[10m])) unless on (peer) vpn_peer_user)) * 8 and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total[10m])) unless on (peer) vpn_peer_user)) > 1024)",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum by (username, inbound) ((rate(vpn_client_tcp_retrans_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_retrans_bytes_total[10m])) unless on (peer) vpn_peer_user)) / sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total[10m])) unless on (peer) vpn_peer_user)) and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total[10m])) unless on (peer) vpn_peer_user)) > 1024)",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (username, inbound) ((vpn_client_tcp_rtt_ms) * on (peer) group_left (username) vpn_peer_user or ((vpn_client_tcp_rtt_ms) unless on (peer) vpn_peer_user)) and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total[10m])) unless on (peer) vpn_peer_user)) > 1024)",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (username, inbound) ((vpn_client_tcp_rtt_inflation) * on (peer) group_left (username) vpn_peer_user or ((vpn_client_tcp_rtt_inflation) unless on (peer) vpn_peer_user)) and (sum by (username, inbound) ((rate(vpn_client_tcp_sent_bytes_total[10m])) * on (peer) group_left (username) vpn_peer_user or ((rate(vpn_client_tcp_sent_bytes_total[10m])) unless on (peer) vpn_peer_user)) > 1024)",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
