# Managed by ansible (roles/observability). Правки на хосте будут перезаписаны.
name: observability

services:
  victoriametrics:
    image: {{ observability_vm_image }}
    container_name: victoriametrics
    restart: unless-stopped
    extra_hosts:
      # node-exporter живёт в host-сети, из bridge он виден только так.
      - "host.docker.internal:host-gateway"
    volumes:
      - vm_data:/victoria-metrics-data
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
    command:
      - "-retentionPeriod={{ observability_metrics_retention }}"
      - "-promscrape.config=/etc/prometheus/prometheus.yml"
    # Без healthcheck: в образе нет ни shell, ни wget — проверять живость
    # изнутри нечем. Состояние видно по /-/healthy снаружи.
    networks:
      - monitoring
{% if observability_panel_metrics_enabled or observability_remote_write_enabled %}
      - edge
{% endif %}
{% if observability_remote_write_enabled %}
    labels:
      traefik.enable: "true"
      # Path, а не PathPrefix: наружу открыт ровно приём записи. Запросы и
      # /api/v1/admin/tsdb/delete_series остаются недоступными снаружи, при
      # том что сама victoriametrics их обслуживает без авторизации.
      traefik.http.routers.vmwrite.rule: "Host(`{{ observability_vm_domain }}`) && Path(`/api/v1/write`)"
      traefik.http.routers.vmwrite.entrypoints: websecure
      traefik.http.routers.vmwrite.tls.certresolver: letsencrypt
      traefik.http.routers.vmwrite.middlewares: vm-write-auth
      # Удвоение $ обязательно: compose иначе принимает $apr1$ за подстановку
      # переменной и молча передаёт traefik обрезанный хеш.
      traefik.http.middlewares.vm-write-auth.basicauth.users: "{{ observability_remote_write_user }}:{{ observability_remote_write_htpasswd | replace('$', '$$') }}"
      traefik.http.services.vmwrite.loadbalancer.server.port: "8428"
{% endif %}

  vmalert:
    image: {{ observability_vmalert_image }}
    container_name: vmalert
    restart: unless-stopped
    volumes:
      - ./vmalert:/etc/alerts:ro
    command:
      - "-datasource.url=http://victoriametrics:8428"
      - "-rule=/etc/alerts/*.yaml"
      - "-notifier.url=http://victoriametrics:8428"
      - "-remoteRead.url=http://victoriametrics:8428"
      - "-remoteWrite.url=http://victoriametrics:8428"
    depends_on:
      - victoriametrics
    networks:
      - monitoring

  loki:
    image: {{ observability_loki_image }}
    container_name: loki
    restart: unless-stopped
    volumes:
      - loki_data:/loki
      - ./loki/config.yaml:/etc/loki/config.yaml:ro
    command: -config.file=/etc/loki/config.yaml
    # Тот же случай, что и у victoriametrics: образ без shell.
    networks:
      - monitoring

  promtail:
    image: {{ observability_promtail_image }}
    container_name: promtail
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /var/lib/docker/containers:/var/lib/docker/containers:ro
      - ./promtail/config.yaml:/etc/promtail/config.yaml:ro
      - promtail_positions:/tmp
    command: -config.file=/etc/promtail/config.yaml
    depends_on:
      - loki
    networks:
      - monitoring

  node-exporter:
    image: {{ observability_node_exporter_image }}
    container_name: node-exporter
    restart: unless-stopped
    network_mode: host
    pid: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
    command:
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"

  cadvisor:
    image: {{ observability_cadvisor_image }}
    container_name: cadvisor
    restart: unless-stopped
    # Набор ниже — не перестраховка. Без него cadvisor видит только cgroup
    # системы и пишет "Failed to create existing container" на каждый
    # docker-*.scope: метрики собираются, но без лейблов name и image, то
    # есть контейнер по ним не опознать, а дашборды остаются пустыми.
    # На cgroup v2 (Ubuntu 24.04+) без privileged и /dev/kmsg не обойтись.
    privileged: true
    # На cgroup v2 docker кладёт каждый контейнер в собственный cgroup
    # namespace, и cadvisor из своего видит только себя — отсюда
    # "Failed to create existing container" на каждый docker-*.scope при
    # полном наборе прав. Хостовый namespace возвращает ему остальные.
    cgroup: host
    devices:
      - /dev/kmsg
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker:/var/lib/docker:ro
      - /dev/disk:/dev/disk:ro
    # Без урезания ответ v0.60 весит 23 МБ и не пролезает в лимит скрейпа
    # victoriametrics (16 МБ): cadvisor прикладывает к каждой метрике все
    # docker-лейблы контейнера. Оставляем два, по которым дашборды группируют,
    # и отключаем метрики, которых здесь никто не читает.
    command:
      - "--store_container_labels=false"
      - "--whitelisted_container_labels=com.docker.compose.project,com.docker.compose.service"
      - "--disable_metrics=percpu,sched,tcp,udp,advtcp,process,hugetlb,referenced_memory,cpu_topology,resctrl"
      - "--docker_only=true"
    networks:
      - monitoring

  grafana:
    image: {{ observability_grafana_image }}
    container_name: grafana
    restart: unless-stopped
    env_file:
      - ./grafana/.env
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/datasources.yaml:/etc/grafana/provisioning/datasources/datasources.yaml:ro
      - ./grafana/dashboards.yaml:/etc/grafana/provisioning/dashboards/dashboards.yaml:ro
      # Каталог, на который смотрит провайдер из dashboards.yaml. Без него
      # провижининг молча находит пустоту: grafana поднимется, датасорсы
      # будут на месте, а список дашбордов останется пустым.
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      - victoriametrics
      - loki
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    networks:
      - monitoring
      - edge
    labels:
      traefik.enable: "true"
      traefik.http.routers.grafana.rule: "Host(`{{ observability_domain }}`)"
      traefik.http.routers.grafana.entrypoints: websecure
      traefik.http.routers.grafana.tls.certresolver: letsencrypt
      traefik.http.services.grafana.loadbalancer.server.port: "3000"

networks:
  monitoring:
    name: monitoring
    driver: bridge
  edge:
    name: {{ observability_edge_network }}
    external: true

volumes:
  vm_data:
    name: observability_vm_data
  grafana_data:
    name: observability_grafana_data
  loki_data:
    name: observability_loki_data
  promtail_positions:
    name: observability_promtail_positions
