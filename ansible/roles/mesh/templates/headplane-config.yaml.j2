# Managed by ansible (roles/mesh). Правки на хосте будут перезаписаны.
server:
  host: "0.0.0.0"
  port: 3000
  # Без него headplane не может собрать абсолютный OIDC-callback из
  # относительного пути и отдаёт 500 (ERR_INVALID_URL). Префикс /admin
  # сюда не входит — headplane добавляет его сам.
  base_url: "https://{{ mesh_domain }}"
  # Ровно 32 символа. 43-символьное значение роняет headplane в рестарт-цикл.
  cookie_secret: "{{ mesh_cookie_secret }}"
  cookie_secure: true

headscale:
  url: "http://headscale:8080"
  config_path: "/etc/headscale/config.yaml"
  config_strict: true
{% if mesh_headscale_api_key | length > 0 %}
  # В 0.7.0 ключ переехал сюда из oidc.headscale_api_key.
  api_key: "{{ mesh_headscale_api_key }}"
{% endif %}

integration:
  docker:
    enabled: true
    container_name: "headscale"
    socket: "unix:///var/run/docker.sock"
{% if mesh_oidc_enabled %}

# Вход в админку через Pocket ID. Клиент заводится в его UI,
# redirect URI: https://{{ mesh_domain }}/admin/oidc/callback
oidc:
  enabled: true
  issuer: "{{ mesh_oidc_issuer }}"
  client_id: "{{ mesh_oidc_client_id }}"
  client_secret: "{{ mesh_oidc_client_secret }}"
  token_endpoint_auth_method: "client_secret_post"
  # Клиент в Pocket ID заведён с обязательным PKCE; без этого
  # /admin/oidc/start падает с "Unexpected error".
  use_pkce: true
  # Оставлен как путь на случай, когда OIDC недоступен: иначе отвалившийся
  # провайдер отрезает от админки вместе с собой.
  disable_api_key_login: false
{% endif %}
