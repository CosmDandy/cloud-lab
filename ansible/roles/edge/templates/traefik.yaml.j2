# Managed by ansible (roles/edge). Правки на хосте будут перезаписаны.
ping: {}

{% if edge_dashboard_domain | length > 0 %}
api:
  dashboard: true
  # Слушатель на 8080 наружу не публикуется: до него достаёт только
  # oauth2-proxy внутри docker-сети, он же и есть аутентификация.
  insecure: true
{% else %}
api:
  dashboard: false
{% endif %}

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
{% if edge_metrics_enabled %}
  metrics:
    address: ":{{ edge_metrics_port }}"
{% endif %}
  websecure:
    address: ":443"
{% if edge_http3_enabled %}
    # Публикует alt-svc, по которому браузер сам переключается на QUIC.
    http3: {}
{% endif %}
    http:
      tls:
        certResolver: letsencrypt
      # Заголовки и сжатие вешаются на точку входа, а не на каждый роутер:
      # иначе новый стек однажды поедет без них, и никто не заметит.
      middlewares:
        - security-headers@file
        - compression@file

{% if edge_metrics_enabled %}
# Отдельная точка входа для метрик: на 80 и 443 её выставлять нельзя, а
# добавлять роутер с аутентификацией ради внутреннего скрейпа — лишняя деталь.
# Порт публикуется только в docker-сеть, снаружи его нет.
metrics:
  prometheus:
    entryPoint: metrics
    # Разбивка по точкам входа, роутерам и сервисам. Без неё видно только
    # «сколько всего запросов», а вопрос обычно звучит «какой сервис отдаёт
    # пятисотки и с какой задержкой».
    addEntryPointsLabels: true
    addRoutersLabels: true
    addServicesLabels: true
    # Гистограмма задержек: по ней считаются перцентили. Границы подобраны под
    # то, что здесь живёт — панель, подписка и статус-страницы отвечают за
    # десятки миллисекунд, всё что больше секунды уже аномалия.
    buckets:
      - 0.05
      - 0.1
      - 0.25
      - 0.5
      - 1.0
      - 2.5
      - 5.0

{% endif %}
certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ edge_acme_email }}
      storage: /letsencrypt/acme.json
{% if edge_acme_ca_server | length > 0 %}
      caServer: {{ edge_acme_ca_server }}
{% endif %}
      httpChallenge:
        entryPoint: web

providers:
  docker:
    exposedByDefault: false
    network: {{ edge_network }}
  # Сюда стеки кладут свои TLS-опции и middleware: роль edge не знает,
  # кто именно приедет на этот хост.
  file:
    directory: /etc/traefik/dynamic
    watch: true
