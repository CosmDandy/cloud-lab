# Managed by ansible (roles/gatus). Правки на хосте будут перезаписаны.
name: {{ gatus_instance }}

services:
  gatus:
    image: {{ gatus_image }}
    container_name: {{ gatus_instance }}
    restart: unless-stopped
    volumes:
      - ./config.yaml:/config/config.yaml:ro
      - {{ gatus_instance }}_data:/data
    expose:
      - "{{ gatus_port }}"
    # ICMP-проверки шлют raw-пакеты. Без этой привилегии они не падают с
    # ошибкой прав, а просто всегда красные — то есть выглядят как лежащий
    # хост, что хуже отсутствия проверки.
    cap_add:
      - NET_RAW
    # Без healthcheck: образ собран без shell, проверять живость изнутри
    # нечем — тот же случай, что у victoriametrics и loki.
    networks:
      - edge
    labels:
      traefik.enable: "true"
      traefik.http.routers.{{ gatus_instance }}.rule: "Host(`{{ gatus_domain }}`)"
      traefik.http.routers.{{ gatus_instance }}.entrypoints: websecure
      traefik.http.routers.{{ gatus_instance }}.tls.certresolver: letsencrypt
      traefik.http.services.{{ gatus_instance }}.loadbalancer.server.port: "{{ gatus_port }}"

networks:
  edge:
    name: {{ gatus_edge_network }}
    external: true

volumes:
  {{ gatus_instance }}_data:
    name: {{ gatus_instance }}_data
