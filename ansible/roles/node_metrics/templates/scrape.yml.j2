# Managed by ansible (roles/node_metrics). Правки на хосте будут перезаписаны.
global:
  scrape_interval: {{ node_metrics_scrape_interval }}

scrape_configs:
  - job_name: node-exporter
    static_configs:
      # instance проставляется здесь, а не через -remoteWrite.label: так он
      # виден и в самом vmagent, если понадобится смотреть его состояние.
      - targets: ["{{ node_metrics_exporter_listen }}"]
        labels:
          instance: {{ node_metrics_instance }}
{% if node_metrics_logs_enabled %}

  # Метрики самого promtail: по ним видно, доезжают ли логи. Без них обрыв
  # доставки выглядит как «на ноде просто тихо».
  - job_name: promtail
    static_configs:
      - targets: ["127.0.0.1:{{ node_metrics_promtail_port }}"]
        labels:
          instance: {{ node_metrics_instance }}
{% endif %}
