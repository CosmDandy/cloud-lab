# Managed by ansible (roles/node_metrics). Правки на хосте будут перезаписаны.
name: node-metrics

services:
  node-exporter:
    image: {{ node_metrics_node_exporter_image }}
    container_name: node-exporter
    restart: unless-stopped
    # host-сеть нужна, чтобы видеть настоящие интерфейсы и их счётчики;
    # pid: host — чтобы различать процессы хоста, а не только свои.
    network_mode: host
    pid: host
    volumes:
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/rootfs:ro
{% if node_metrics_tcp_quality_enabled %}
      # Готовые метрики, которые пишет tcp-quality.timer. Собирать их внутри
      # контейнера нечем: ss читает состояние сокетов через netlink хоста.
      - {{ node_metrics_textfile_dir }}:{{ node_metrics_textfile_dir }}:ro
{% endif %}
    command:
      - "--web.listen-address={{ node_metrics_exporter_listen }}"
      - "--path.procfs=/host/proc"
      - "--path.sysfs=/host/sys"
      - "--path.rootfs=/rootfs"
      - "--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)"
{% if node_metrics_tcp_quality_enabled %}
      - "--collector.textfile.directory={{ node_metrics_textfile_dir }}"
{% endif %}

  vmagent:
    image: {{ node_metrics_vmagent_image }}
    container_name: vmagent
    restart: unless-stopped
    # Тоже host-сеть: иначе 127.0.0.1 в конфиге скрейпа указывал бы внутрь
    # самого контейнера, где node-exporter не слушает.
    network_mode: host
    volumes:
      - ./scrape.yml:/etc/vmagent/scrape.yml:ro
      - ./remote-write-password:/etc/vmagent/password:ro
      - vmagent_data:/vmagent-data
    command:
      # Без явного адреса vmagent слушает 0.0.0.0:8429, а он в host-сети:
      # его /targets и /metrics отвечали из интернета, и туда же смотрел
      # приём записи. Наружу с ноды не должно смотреть ничего.
      - "-httpListenAddr={{ node_metrics_vmagent_listen }}"
      - "-promscrape.config=/etc/vmagent/scrape.yml"
      - "-remoteWrite.url={{ node_metrics_remote_write_url }}"
      - "-remoteWrite.basicAuth.username={{ node_metrics_remote_write_user }}"
      # Пароль файлом, а не аргументом: аргументы видны в ps любому
      # пользователю машины.
      - "-remoteWrite.basicAuth.passwordFile=/etc/vmagent/password"
      - "-remoteWrite.tmpDataPath=/vmagent-data"
      - "-remoteWrite.maxDiskUsagePerURL={{ node_metrics_max_disk_usage }}"

{% if node_metrics_logs_enabled %}
  alloy:
    image: {{ node_metrics_alloy_image }}
    container_name: alloy
    restart: unless-stopped
    volumes:
      # loki.source.docker reads logs through the docker API and needs no
      # access to the log files themselves.
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./alloy-config.alloy:/etc/alloy/config.alloy:ro
      # Логи xray лежат файлами: rw-node не отдаёт stdout ядра в docker logs.
      - {{ node_metrics_xray_log_dir }}:{{ node_metrics_xray_log_dir }}:ro
      - ./remote-write-password:/etc/alloy/password:ro
      # Positions: without them a restart counts as a first start (see the
      # stage.drop in the config).
      - alloy_data:/var/lib/alloy/data
{% if node_metrics_xray_logs_enabled %}
      # promtail's offsets, read once on alloy's first start so the xray
      # files resume where promtail stopped (legacy_positions_file).
      # TODO: drop this mount and the volume once every node runs alloy.
      - promtail_positions:/var/lib/promtail-positions:ro
{% endif %}
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy/data
      # Host network, as vmagent: the address is spelled out rather than left
      # to a default, because promtail's gRPC default was 0.0.0.0. This is
      # alloy's only listener; vmagent scrapes its metrics here, so log
      # delivery shows up next to everything else.
      - --server.http.listen-addr=127.0.0.1:{{ node_metrics_alloy_port }}
      # Usage reporting to stats.grafana.org is on by default; the only
      # connection this collector needs is the one to loki.
      - --disable-reporting
    network_mode: host
{% endif %}

volumes:
  vmagent_data:
    name: node_metrics_vmagent_data
{% if node_metrics_logs_enabled %}
  alloy_data:
    name: node_metrics_alloy_data
{% if node_metrics_xray_logs_enabled %}
  promtail_positions:
    name: node_metrics_promtail_positions
{% endif %}
{% endif %}
