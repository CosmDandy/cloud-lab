# Managed by ansible (roles/node_metrics). Правки на хосте будут перезаписаны.
server:
  # Только петля: контейнер в host-сети, и 0.0.0.0 выставил бы метрики
  # promtail в интернет.
  http_listen_address: 127.0.0.1
  http_listen_port: {{ node_metrics_promtail_port }}
  # Логи самого promtail на уровне info — это строка на каждую отправку;
  # при обрыве связи с loki важны как раз warn и error.
  log_level: warn

positions:
  filename: /tmp/positions.yaml

clients:
  - url: {{ node_metrics_loki_url }}
    basic_auth:
      username: {{ node_metrics_remote_write_user }}
      # Файлом, а не значением: конфиг читаемый, пароль — нет.
      password_file: /etc/promtail/password
    # Нода может остаться без control-plane на минуты: инцидент 14.08 в Осло
    # длился десять. Backoff досылает накопленное вместо того, чтобы бросить.
    backoff_config:
      min_period: 500ms
      max_period: 5m
      max_retries: 20

scrape_configs:
  - job_name: docker
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: ["__meta_docker_container_name"]
        target_label: container
        regex: /(.+)
      - source_labels: ["__meta_docker_container_log_stream"]
        target_label: stream
      # Без него логи трёх нод сольются в один поток — ровно та же ошибка,
      # что с instance у метрик.
      - target_label: host
        replacement: {{ node_metrics_instance }}
