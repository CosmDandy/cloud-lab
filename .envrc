# Окружение репозитория. Подхватывается direnv при входе в каталог;
# первый раз нужно разрешить: `direnv allow`.
#
# Файл коммитится и секретов не содержит — только пути. Сам ключ age
# лежит вне репозитория, в ~/.config/sops/age/keys.txt.

# ansible.cfg живёт в подкаталоге, но плейбуки удобнее запускать из корня.
export ANSIBLE_CONFIG="${PWD}/ansible/ansible.cfg"

# sops ищет ключ здесь и по умолчанию, но путь указан явно: иначе при
# запуске из другого HOME (CI, sudo) молча берётся не тот ключ, и ошибка
# выглядит как «не удалось расшифровать», а не «ключ не найден».
export SOPS_AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"

if [ ! -f "${SOPS_AGE_KEY_FILE}" ]; then
  log_error "нет ключа age: ${SOPS_AGE_KEY_FILE}"
  log_error "восстановить из Bitwarden: bw get item sops-age --raw"
fi
