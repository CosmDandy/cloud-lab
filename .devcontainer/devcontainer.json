// Пребилт-образ из CosmDandy/dotfiles: плагины nvim, mason-пакеты и
// treesitter-парсеры уже внутри, поэтому нет onCreateCommand и setup.sh.
// Профили: :core — редактор и шелл, :devops — плюс terraform/k8s/ansible.
// containerEnv, а не remoteEnv: локаль нужна и демонам, и docker exec.
{
  "name": "cloud-lab DevContainer",
  "image": "ghcr.io/cosmdandy/devcontainer:devops",
  // docker не перетягивает уже скачанный плавающий тег — хост залипает на
  // первом образе (ловили сборку 5-дневной давности при живом CI). Команда
  // идёт на хосте до создания контейнера: тот же дайджест — no-op, офлайн —
  // едем на локальном (|| true).
  "initializeCommand": "docker pull ghcr.io/cosmdandy/devcontainer:devops || true",
  "containerEnv": {
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "TZ": "Europe/Moscow"
  },
  "remoteEnv": {
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  }
}
